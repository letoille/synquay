# Reference only: the server does not automatically load this file.
SYNQUAY_BIND=127.0.0.1:8080
SYNQUAY_LOG_FORMAT=text
RUST_LOG=info,synquay_server=debug
SYNQUAY_API_TARGET=http://127.0.0.1:8080

# Optional: enable the durable HTTP relay. Create data/ and export a random secret first.
# SYNQUAY_PIPELINE_CONFIG=examples/pipeline.example.json
# SYNQUAY_WEBHOOK_TOKEN=<at-least-32-random-printable-characters>

# Optional production console assets (must contain index.html)
# SYNQUAY_WEB_DIR=/usr/share/synquay/web
