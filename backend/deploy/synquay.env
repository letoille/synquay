# systemd EnvironmentFile syntax; no shell substitutions.
SYNQUAY_BIND=127.0.0.1:8080
SYNQUAY_WEB_DIR=/usr/share/synquay/web
SYNQUAY_TOOLS_CONFIG=/etc/synquay/tools.json
SYNQUAY_TOOLS_SECURITY_CONFIG=/etc/synquay/security.json
SYNQUAY_PIPELINE_CONFIG=/etc/synquay/pipeline.json
SYNQUAY_LOG_FORMAT=json
RUST_LOG=info
