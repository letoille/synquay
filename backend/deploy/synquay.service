[Unit]
Description=Synquay application, messages and MCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=synquay
Group=synquay
WorkingDirectory=/var/lib/synquay
EnvironmentFile=/etc/synquay/synquay.env
EnvironmentFile=/etc/synquay/credentials.env
ExecStart=/usr/bin/synquay-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
StateDirectory=synquay
StateDirectoryMode=0750
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synquay
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/synquay

[Install]
WantedBy=multi-user.target
